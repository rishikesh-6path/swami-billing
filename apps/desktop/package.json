{
  "name": "@shopledger/desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "e2e": "electron-vite build && node scripts/run-e2e.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package:win": "electron-vite build && electron-builder --config electron-builder.yml --win nsis --x64 --publish never",
    "package:dir": "electron-vite build && electron-builder --config electron-builder.yml --dir --publish never"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@shopledger/core": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^7.3.6",
    "zod": "^4.6.5"
  },
  "description": "ShopLedger: offline billing and accounts for a small shop",
  "author": "ShopLedger"
}
