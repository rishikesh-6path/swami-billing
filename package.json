{
  "name": "shopledger",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --filter @shopledger/desktop dev",
    "test": "pnpm --filter @shopledger/core test",
    "test:core": "pnpm --filter @shopledger/core test:file",
    "e2e": "pnpm --filter @shopledger/desktop e2e",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "migrate:new": "node scripts/migrate-new.mjs",
    "build:win": "pnpm --filter @shopledger/desktop package:win"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
